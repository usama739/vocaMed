APP_NAME=VocaMed
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vocamed
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Telescope (a developer's window at /telescope: requests, queries, jobs, mail, logs, exceptions). Developer machine only: it is
# not registered in any other environment. After pulling, run `php artisan migrate` once (it adds its own tables).
TELESCOPE_ENABLED=true

# Live updates (Reverb, Laravel's own WebSocket server; see docs/backend/m9-live-updates.md). With "log" nothing is sent and the
# screens keep refreshing on a timer. To switch on, set BROADCAST_CONNECTION=reverb, keep `composer dev` running (it starts
# reverb:start and the queue worker) and make the three values below private ones of your own. The VITE_ lines let the page
# connect (restart `pnpm dev` / rebuild after changing them). Real sign-in (VITE_REAL_AUTH=true) is needed: the demo has no server.
BROADCAST_CONNECTION=log
REVERB_APP_ID=vocamed-local
REVERB_APP_KEY=vocamed-local-key
REVERB_APP_SECRET=vocamed-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Production: the address of the clinic site, so no other page can open a connection (comma separated). "*" is for local use.
# REVERB_ALLOWED_ORIGINS=https://app.example.com
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. "log" sends nothing (the message is written to storage/logs/laravel.log; the sign-up, invitation and password-reset
# emails also show at /dev/inbox). To send for real set MAIL_MAILER=smtp and the settings of a provider, for example Mailtrap's
# sandbox inbox for testing (Mailtrap > Email Testing > Inboxes > SMTP settings):
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<from Mailtrap>
#   MAIL_PASSWORD=<from Mailtrap>
#   MAIL_FROM_ADDRESS="hello@your-domain.example"
# Then check it with: php artisan mail:test you@example.com   (step-by-step guide: docs/testing/mailtrap-setup.md)
# Emails are queued: keep `composer dev` running (it runs the queue worker), or set QUEUE_CONNECTION=sync to send at once.
# Reminders before visits are filed by the scheduler: run `php artisan schedule:work` next to it.
# Messages to patients: MESSAGES_EMAIL_DRIVER=mail sends email; SMS and WhatsApp stay on "log" (nothing is sent) until a provider is added.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Voice booking (M10). The parser ("rules") is plain code with no network; speech starts on "fake" (fixed answers). For real speech, make a free Groq key at https://console.groq.com
# and put it only in your own .env, never in this file:
#   SPEECH_DRIVER=whisper_http
#   SPEECH_BASE_URL=https://api.groq.com/openai/v1
#   SPEECH_API_KEY=<your key>
#   SPEECH_MODEL=whisper-large-v3-turbo
# The whisper_http driver is built in step V3; until then keep SPEECH_DRIVER=fake (a recording otherwise ends as failed, "provider_error").
# A free hosted provider is for development and made-up patients only (docs/backend/m10-voice.md).
SPEECH_DRIVER=fake
INTENT_DRIVER=rules
# Optional: SPEECH_LANGUAGE=ur (a hint; empty lets the provider work it out), SPEECH_SECONDS_PER_HOUR=7000, SPEECH_SECONDS_PER_DAY=28000 and
# SPEECH_REQUESTS_PER_DAY=1900 keep recordings under Groq's free tier (set them higher, or 0, for a paid provider).
# Optional language-model parser, only for sentences the rules cannot read (sends that text to the provider): INTENT_DRIVER=rules_llm with
# INTENT_BASE_URL, INTENT_API_KEY (defaults to SPEECH_API_KEY) and INTENT_MODEL=openai/gpt-oss-20b.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REAL_AUTH=false

VOCAMED_SELF_SERVICE_SIGNUP=true
