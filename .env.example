APP_NAME=VocaMed
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vocamed
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. "log" sends nothing (the message is written to storage/logs/laravel.log; the sign-up, invitation and password-reset
# emails also show at /dev/inbox). To send for real set MAIL_MAILER=smtp and the settings of a provider, for example Mailtrap's
# sandbox inbox for testing (Mailtrap > Email Testing > Inboxes > SMTP settings):
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<from Mailtrap>
#   MAIL_PASSWORD=<from Mailtrap>
#   MAIL_FROM_ADDRESS="hello@your-domain.example"
# Then check it with: php artisan mail:test you@example.com   (step-by-step guide: docs/testing/mailtrap-setup.md)
# Emails are queued: keep `composer dev` running (it runs the queue worker), or set QUEUE_CONNECTION=sync to send at once.
# Reminders before visits are filed by the scheduler: run `php artisan schedule:work` next to it.
# Messages to patients: MESSAGES_EMAIL_DRIVER=mail sends email; SMS and WhatsApp stay on "log" (nothing is sent) until a provider is added.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REAL_AUTH=false

VOCAMED_SELF_SERVICE_SIGNUP=true
